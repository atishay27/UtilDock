/*
  # The site is same-origin apart from one deliberate exception: the Google Tag
  # Manager container, which loads only after a visitor grants consent (see
  # src/components/Analytics.astro — gtm.js is not injected before that).
  #
  # Read this before relaxing anything further. connect-src used to be 'self'
  # alone, which made exfiltration of a pasted document impossible rather than
  # merely unintended. With Google's endpoints allowed, that property now rests
  # on no code path reading the editor buffer into a request — a design
  # commitment rather than something the browser enforces for us. Every origin
  # added here widens the same hole. The bar for the next one: it ships nothing
  # without consent, and there is no first-party way to get the same answer.
  #
  # script-src carries no 'unsafe-inline'. The token below is replaced at build
  # time by scripts/csp-hashes.mjs with one SHA-256 per inline script actually in
  # the output — they cannot be written by hand because Astro emits its own
  # island-hydration loaders whose contents change between builds.
  #
  # style-src keeps 'unsafe-inline' and cannot lose it: CodeMirror writes its
  # rules into a <style> via textContent, and the tree viewer sets a transform
  # per scroll frame. Neither is knowable ahead of time. The exposure is far
  # smaller than the script case — CSS could only exfiltrate by fetching an
  # external URL, and default-src, img-src, font-src and connect-src are all
  # 'self', so there is nowhere for it to fetch from.
  #
  # The Google hosts below are scoped as tightly as GTM and GA4 permit:
  # googletagmanager for the container and the tag, google-analytics and
  # analytics.google for the regional collection endpoints GA4 picks at runtime,
  # and an img-src entry for the pixel it falls back to when fetch is
  # unavailable. No advertising host is listed, and none should be — ad_storage
  # is denied unconditionally in the Consent Mode defaults.
  #
  # This list is also the guard on the GTM console. A container can load any
  # vendor its tags name, so anyone with console access could otherwise add a
  # third party to every page without a commit. Because only Google's own hosts
  # are allowed here, such a tag is blocked by the browser until this file is
  # edited and reviewed. Treat a CSP violation from a new tag as the control
  # working, not as a bug to silence.
  #
  # frame-src is intentionally absent, so default-src 'self' blocks the GTM
  # <noscript> iframe. That snippet is not shipped either; see the note in
  # src/components/Analytics.astro for why.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com {{SCRIPT_HASHES}}; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  # Redundant with frame-ancestors above, which wins wherever both are read.
  # Kept for browsers predating CSP Level 2, and because scanners score it.
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Cloudflare attaches its own NEL policy, which asks the browser to report
  # network errors to a.nel.cloudflare.com. The Reporting API is not governed by
  # CSP, so that is genuine off-origin traffic from a visitor's browser. A zero
  # max_age unregisters the policy instead of renewing it.
  NEL: {"max_age":0}
  Report-To: {"group":"cf-nel","max_age":0,"endpoints":[]}
  # The same two faces the <head> preloads, repeated as a header so Cloudflare's
  # Early Hints has something to put in a 103 — it reads Link:, not markup, and
  # the markup arrives too late to be worth hinting. Written by
  # scripts/csp-hashes.mjs from the built HTML rather than by hand, because the
  # filenames carry a content hash and the two lists must not drift apart.
  #
  # This rides on every response, including the assets, which is the cost of
  # _headers having no glob that means "documents only". Next to the CSP above
  # it is noise.
  Link: {{FONT_PRELOAD}}

# Hashed build output never changes under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/icon-*.png
  Cache-Control: public, max-age=604800

/og-default.png
  Cache-Control: public, max-age=604800

# The service worker must always be revalidated or updates never ship.
# Spelled out rather than a bare `no-cache`: Cloudflare's edge ignored that and
# applied its 4-hour default, which would have delayed every worker update.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Content-hashed by scripts/fetch-fonts.mjs, so a changed face is a changed
# name. Held for a year: the daily revalidation this replaces cost a round trip
# on a render-blocking preload, every day, to be told nothing had changed.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
