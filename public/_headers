/*
  # Everything the site needs is same-origin, so the policy can simply forbid
  # outbound connections. This is the mechanism behind the privacy promise:
  # even a compromised dependency could not post your JSON anywhere.
  #
  # script-src carries no 'unsafe-inline'. The token below is replaced at build
  # time by scripts/csp-hashes.mjs with one SHA-256 per inline script actually in
  # the output — they cannot be written by hand because Astro emits its own
  # island-hydration loaders whose contents change between builds.
  #
  # style-src keeps 'unsafe-inline' and cannot lose it: CodeMirror writes its
  # rules into a <style> via textContent, and the tree viewer sets a transform
  # per scroll frame. Neither is knowable ahead of time. The exposure is far
  # smaller than the script case — CSS could only exfiltrate by fetching an
  # external URL, and default-src, img-src, font-src and connect-src are all
  # 'self', so there is nowhere for it to fetch from.
  #
  # Do not add a host to script-src or connect-src to accommodate an analytics
  # or monitoring product. Every allowed origin is a route data could leave by,
  # and that is precisely what this policy exists to prevent.
  Content-Security-Policy: default-src 'self'; script-src 'self' {{SCRIPT_HASHES}}; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # Cloudflare attaches its own NEL policy, which asks the browser to report
  # network errors to a.nel.cloudflare.com. The Reporting API is not governed by
  # CSP, so that is genuine off-origin traffic from a visitor's browser. A zero
  # max_age unregisters the policy instead of renewing it.
  NEL: {"max_age":0}
  Report-To: {"group":"cf-nel","max_age":0,"endpoints":[]}

# Hashed build output never changes under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/icon-*.png
  Cache-Control: public, max-age=604800

/og-default.png
  Cache-Control: public, max-age=604800

# The service worker must always be revalidated or updates never ship.
# Spelled out rather than a bare `no-cache`: Cloudflare's edge ignored that and
# applied its 4-hour default, which would have delayed every worker update.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Self-hosted and never renamed, so revalidate daily rather than hold a year.
/fonts/*
  Cache-Control: public, max-age=86400
