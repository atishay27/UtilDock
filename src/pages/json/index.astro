---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolRow from '../../components/ToolRow.astro';
import Icon from '../../components/Icon.astro';
import { getCategory, toolsInCategory } from '../../lib/tools';
import { SITE, absoluteUrl } from '../../lib/site';

const category = getCategory('json');
const tools = toolsInCategory('json');
const live = tools.filter((t) => t.status === 'live');
const url = absoluteUrl('/json');

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: `JSON tools — ${SITE.name}`,
      url,
      description: category.blurb,
      isPartOf: { '@type': 'WebSite', '@id': `${SITE.url}/#website` },
    },
    {
      '@type': 'ItemList',
      name: 'JSON tools',
      itemListElement: live.map((tool, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: tool.name,
        description: tool.tagline,
        url: absoluteUrl(tool.href),
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
        { '@type': 'ListItem', position: 2, name: 'JSON', item: url },
      ],
    },
  ],
};

/* Each answers a question people actually search before picking a tool. */
const notes = [
  {
    head: 'Nothing you paste is uploaded',
    body: 'Every tool here is JavaScript running in your own tab. Paste a production payload with the network disconnected and it still works — there is no server of ours that could receive it.',
  },
  {
    head: 'No ads, no account, no limit',
    body: 'No interstitials, no sign-up and no cap on how much you can paste. The page you land on is the tool.',
  },
  {
    head: 'Built for large documents',
    body: 'Parsing, validation and diffing run on a worker thread, so a multi-megabyte document is worked without the page seizing while you type.',
  },
];
---

<BaseLayout
  title="JSON Tools — free, ad-free, in your browser"
  description="Free online JSON tools: viewer, validator, diff and formatter. No ads, no sign-up, and nothing you paste ever leaves your browser."
  keywords={['json tools', 'online json tools', 'free json tools', 'json utilities']}
  structuredData={structuredData}
>
  <section class="ud-scale border-b border-scribe">
    <div class="mx-auto max-w-[1600px] px-4 pt-14 pb-12 sm:px-6 sm:pt-20">
      <nav aria-label="Breadcrumb" class="ud-legend flex items-center gap-2">
        <a href="/" class="transition-colors hover:text-chalk">Home</a>
        <span aria-hidden="true">/</span>
        <span>JSON</span>
      </nav>

      <h1 class="mt-3 max-w-[18ch] text-[clamp(2.75rem,8vw,6rem)] text-chalk">
        Every JSON tool, <span class="text-cherry">in one tab.</span>
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-temper">
        Four sharp tools for working with JSON — a tree <a
          href="/json/viewer"
          class="text-chalk underline decoration-scribe-strong underline-offset-4 transition-colors hover:text-cherry"
          >viewer</a
        >, a syntax and schema <a
          href="/json/validator"
          class="text-chalk underline decoration-scribe-strong underline-offset-4 transition-colors hover:text-cherry"
          >validator</a
        >, a visual <a
          href="/json/diff"
          class="text-chalk underline decoration-scribe-strong underline-offset-4 transition-colors hover:text-cherry"
          >comparator</a
        > and a <a
          href="/json/formatter"
          class="text-chalk underline decoration-scribe-strong underline-offset-4 transition-colors hover:text-cherry"
          >formatter and minifier</a
        >. All free, all ad-free, and every one of them parses your document in this tab rather than
        on a server.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1600px] px-4 pt-14 sm:px-6">
    <div
      class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b-2 border-scribe-strong pb-4"
    >
      <h2 class="text-[clamp(1.9rem,4.5vw,3rem)] text-chalk">Choose a tool</h2>
      <p class="ud-legend">{live.length} tools · more coming</p>
    </div>

    <div>
      {tools.map((tool) => <ToolRow tool={tool} />)}
    </div>
  </section>

  <section class="mx-auto max-w-[1600px] px-4 pt-16 pb-4 sm:px-6">
    <div class="grid gap-x-12 gap-y-10 md:grid-cols-3">
      {
        notes.map((note) => (
          <div class="border-t-2 border-cherry pt-5">
            <h2 class="ud-struck text-[1.6rem] text-chalk">{note.head}</h2>
            <p class="mt-3 text-sm leading-relaxed text-temper">{note.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-16 border-y-2 border-scribe-strong bg-bench">
    <div class="ud-scale">
      <div
        class="mx-auto flex max-w-[1600px] flex-col items-start gap-6 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between"
      >
        <p class="ud-struck max-w-[24ch] text-[clamp(1.6rem,3.5vw,2.5rem)] text-chalk">
          Check the claim in your Network panel.
        </p>
        <a
          href="/privacy"
          class="ud-struck flex shrink-0 items-center gap-2 border border-scribe-strong px-6 py-3 text-lg text-chalk transition-colors hover:border-cherry hover:text-cherry"
        >
          How that is true
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
