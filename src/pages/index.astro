---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolRow from '../components/ToolRow.astro';
import Icon from '../components/Icon.astro';
import { LIVE_TOOLS, populatedCategories } from '../lib/tools';
import { SITE, absoluteUrl } from '../lib/site';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      name: SITE.name,
      alternateName: SITE.tagline,
      url: absoluteUrl('/'),
      description: SITE.description,
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: absoluteUrl('/'),
      logo: new URL('/icon-512.png', SITE.url).href,
      description: SITE.description,
    },
    {
      '@type': 'ItemList',
      name: `Tools on ${SITE.name}`,
      itemListElement: LIVE_TOOLS.map((tool, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: tool.name,
        description: tool.tagline,
        url: absoluteUrl(tool.href),
      })),
    },
  ],
};

/* The directory, grouped by category and built entirely from the registry. A
   new category appears here by existing, which is the point: this page should
   not need editing every time the dock grows. */
const groups = populatedCategories();

/* The three claims, as one row of legends rather than the band of figures and
   paragraphs this page used to open with. */
const assurances = ['Nothing uploaded', 'Nothing logged', 'No account, no limits'];
---

<BaseLayout
  title="Free JSON tools that never leave your browser"
  description={SITE.description}
  keywords={['developer tools', 'json tools', 'online json formatter', 'free developer utilities']}
  structuredData={structuredData}
>
  {/* FIRST VIEWPORT ---------------------------------------------------- */}
  <section class="ud-scale relative overflow-hidden border-b border-scribe">
    <div class="mx-auto max-w-[1600px] px-4 pt-16 pb-0 sm:px-6 sm:pt-24">
      <h1
        class="ud-strike max-w-[22ch] text-[clamp(3.25rem,11vw,9rem)] text-chalk"
        style="--ud-delay: 120ms"
      >
        {/* Not "JSON tools": the dock is meant to grow past JSON, and a headline
             that names one format has to be rewritten the day it does. The
             promise generalises; the inventory below is what changes. The full
             stop rides inside the accent because this face sets it as a solid
             square that reads as a stray block in the body colour. */}
        Developer tools that never <span class="text-cherry">touch a server.</span>
      </h1>

      <p
        class="ud-strike mt-7 max-w-2xl text-lg leading-relaxed text-temper"
        style="--ud-delay: 220ms"
      >
        Small, sharp utilities that run entirely in this tab — free, ad-free and with no sign-up.
        JSON first: a formatter, a viewer, a validator and a comparator, with JWT next.
      </p>
    </div>

    {/* The billet: the system's signature object, and the page's one divider.
        It used to carry two buttons that repeated the nav directly above them —
        the tools themselves start one screen down, and are the real action. */}
    <div class="relative mt-12 sm:mt-16">
      <div class="ud-billet ud-draw absolute inset-0" style="--ud-delay: 420ms"></div>
      <div class="ud-scale pointer-events-none absolute inset-0 opacity-50"></div>

      {/* Scale leaping off where the hammer struck. */}
      <div class="pointer-events-none absolute inset-y-0 left-[6%] w-64" aria-hidden="true">
        {
          [
            { x: 34, y: -34, d: 620, t: 18, l: 20 },
            { x: 52, y: -50, d: 700, t: 40, l: 46 },
            { x: 26, y: -26, d: 780, t: 62, l: 8 },
            { x: 44, y: -42, d: 860, t: 30, l: 68 },
            { x: 30, y: -56, d: 940, t: 55, l: 88 },
          ].map((fleck) => (
            <span
              class="ud-shed absolute size-1.5 bg-stamp"
              style={`--shed-x:${fleck.x}px; --shed-y:${fleck.y}px; --ud-delay:${fleck.d}ms; top:${fleck.t}%; left:${fleck.l}%`}
            />
          ))
        }
      </div>

      {/*
        The bar carried the four tool names for a while, which made it the third
        copy of the same menu — header dropdown, bar, directory — and the names
        had to be shortened to "Viewer" and "Validator" to fit, which is exactly
        the ambiguity the nav rebuild set out to remove. It would also have been
        the first thing to break as the dock grows past one category.

        What it carries instead is the claim, stamped into hot metal: the one
        piece of copy that is true of every tool the dock will ever hold, and
        the only thing on the page that belongs on a signature object rather
        than in a list. Stamp tokens, not theme tokens — the metal is hot in
        both registers, so a theme-following colour vanishes on the light side.
      */}
      <ul
        class="ud-strike relative mx-auto flex max-w-[1600px] flex-wrap items-center gap-x-4 gap-y-1 px-4 py-4 sm:px-6 sm:py-5"
        style="--ud-delay: 300ms"
      >
        {
          assurances.map((assurance, index) => (
            <li class="ud-struck flex items-center gap-4 text-lg text-stamp sm:text-xl">
              {index > 0 && (
                <span class="h-4 w-[2px] bg-stamp opacity-40" aria-hidden="true" />
              )}
              {assurance}
            </li>
          ))
        }
      </ul>
    </div>

  </section>

  {/*
    THE DIRECTORY --------------------------------------------------------

    The page's one and only list of tools. It had grown to three — a strip on
    the bar, a grid of situations, and this — all naming the same four things,
    which is what made the homepage feel like the nav pasted in three costumes.

    Grouping by category is what makes it survive growth: a new category is a
    new heading and its rows, and nothing on this page is edited to add one.
  */}
  <section id="tools" class="mx-auto max-w-[1600px] scroll-mt-16 px-4 pt-16 sm:px-6 sm:pt-24">
    {
      groups.map((group, groupIndex) => (
        <div class:list={[groupIndex > 0 && 'mt-20']}>
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b-2 border-scribe-strong pb-4">
            <div>
              <h2 class="text-[clamp(2rem,5vw,3.5rem)] text-chalk">{group.category.name} tools</h2>
              {/* The measure belongs on the paragraph. On the wrapper, 42ch was
                  resolved against the body font and squeezed the blurb into a
                  336px column with one orphaned word. */}
              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-temper">
                {group.category.blurb}
              </p>
            </div>

            {group.category.href && (
              <a
                href={group.category.href}
                class="ud-legend group flex items-center gap-1.5 transition-colors hover:text-chalk"
              >
                All {group.category.name} tools
                <Icon
                  name="arrow-right"
                  size={13}
                  class="text-cherry transition-transform group-hover:translate-x-0.5"
                />
              </a>
            )}
          </div>

          {group.tools.map((tool) => (
            <ToolRow tool={tool} />
          ))}
        </div>
      ))
    }
  </section>

  {/*
    THE CLOSE -----------------------------------------------------------

    The three-column band that used to sit here said "nothing you paste is
    uploaded", "no ads, no sign-up, no limits" and "built for large documents" —
    the first two restating the readout above it almost word for word, and all
    three duplicated on /json, which is the page that should own the long form
    of the argument. Home keeps the claim in the headline and settles it here in
    one row; /json and /privacy carry the reasoning.
  */}
  <section class="mt-20 border-y-2 border-scribe-strong bg-bench">
    <div class="ud-scale">
      <div
        class="mx-auto flex max-w-[1600px] flex-col items-start gap-8 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between"
      >
        <p class="ud-struck max-w-[20ch] text-[clamp(1.75rem,4vw,3rem)] text-chalk">
          Unplug the network. It still works.
        </p>
        <a
          href="/privacy"
          class="ud-struck shrink-0 border border-scribe-strong px-6 py-3 text-lg text-chalk transition-colors hover:border-cherry hover:text-cherry"
        >
          How that is true
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
