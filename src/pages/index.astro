---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolRow from '../components/ToolRow.astro';
import Icon from '../components/Icon.astro';
import { TOOLS, LIVE_TOOLS } from '../lib/tools';
import { SITE, absoluteUrl } from '../lib/site';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      name: SITE.name,
      alternateName: SITE.tagline,
      url: absoluteUrl('/'),
      description: SITE.description,
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: absoluteUrl('/'),
      logo: new URL('/icon-512.png', SITE.url).href,
      description: SITE.description,
    },
    {
      '@type': 'ItemList',
      name: `Tools on ${SITE.name}`,
      itemListElement: LIVE_TOOLS.map((tool, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: tool.name,
        description: tool.tagline,
        url: absoluteUrl(tool.href),
      })),
    },
  ],
};

/* A bare figure is not a measurement: the label has to finish the sentence, or
   three big zeros read as data that failed to load. Each claim is checkable in
   the Network panel, which is what the fourth cell is for. */
const readout = [
  {
    value: '0',
    label: 'bytes of your JSON uploaded',
    note: 'It is parsed in this tab, by this tab. There is no server to send it to.',
  },
  {
    value: '0',
    label: 'accounts, sign-ups or limits',
    note: 'No profile to build and no cap on what you paste. Nothing here is gated.',
  },
  {
    value: '0',
    label: 'ads, ever',
    note: 'No banners, no interstitials, no affiliate links. The page you land on is the tool.',
  },
];

/* The same colours the tools use, so the legend teaches the interface. */
const heats = [
  { swatch: 'bg-cold', name: 'Cold', meaning: 'Nothing on the anvil yet' },
  { swatch: 'bg-cherry', name: 'Working', meaning: 'Being parsed as you type' },
  { swatch: 'bg-sound', name: 'Sound', meaning: 'Valid — the piece rings true' },
  { swatch: 'bg-fault', name: 'Fault', meaning: 'A crack, located to the column' },
];

const temper = [
  {
    head: 'The billet never leaves',
    body: 'Every tool is JavaScript running on your own anvil. Your document is never uploaded, logged or seen by us, because there is no server of ours that could receive it.',
  },
  {
    head: 'Scale shatters, nothing is wasted',
    body: 'No ads, no interstitials, no account wall. What comes off the bar is the part you did not need — never your attention.',
  },
  {
    head: 'Struck cold or white-hot',
    body: 'Parsing and diffing move to a worker thread, so a multi-megabyte document is worked without the page ever seizing under the hammer.',
  },
];
---

<BaseLayout
  title="Free JSON tools that never leave your browser"
  description={SITE.description}
  keywords={['developer tools', 'json tools', 'online json formatter', 'free developer utilities']}
  structuredData={structuredData}
>
  {/* FIRST VIEWPORT ---------------------------------------------------- */}
  <section class="ud-scale relative overflow-hidden border-b border-scribe">
    <div
      class="mx-auto grid max-w-[1600px] gap-x-16 gap-y-12 px-4 pt-16 pb-0 sm:px-6 sm:pt-24 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-end"
    >
      <div>
      <h1
        class="ud-strike max-w-[16ch] text-[clamp(3.25rem,11vw,9rem)] text-chalk"
        style="--ud-delay: 120ms"
      >
        {/* The full stop rides inside the accent: this face sets it as a solid
             square that reads as a stray block in the body colour. */}
        Work it on your <span class="text-cherry">own anvil.</span>
      </h1>

      <p
        class="ud-strike mt-7 max-w-xl text-lg leading-relaxed text-temper"
        style="--ud-delay: 220ms"
      >
        {SITE.name} is a shop of free developer tools that never send your work anywhere — a JSON
        viewer, validator, comparator and formatter, with no ads and no sign-up. Paste a production
        payload with the network unplugged and it still runs.
      </p>

      </div>

      {/* The heat plate: the state vocabulary every tool uses, shown once. */}
      <aside class="ud-strike border border-scribe-strong bg-anvil" style="--ud-delay: 380ms">
        <h2 class="ud-legend border-b border-scribe bg-bench px-4 py-2.5 text-chalk">
          Reading the heat
        </h2>
        <dl>
          {
            heats.map((heat, index) => (
              <div
                class:list={[
                  'flex items-baseline gap-3 px-4 py-3',
                  index > 0 && 'border-t border-scribe',
                ]}
              >
                <span class={`mt-1 size-2.5 shrink-0 ${heat.swatch}`} />
                <dt class="ud-legend w-16 shrink-0 text-chalk">{heat.name}</dt>
                <dd class="text-xs leading-relaxed text-temper">{heat.meaning}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>

    {/* The bar carries the page's actions, stamped into metal still workable. */}
    <div class="relative mt-12 sm:mt-16">
      <div class="ud-billet ud-draw absolute inset-0" style="--ud-delay: 420ms"></div>
      <div class="ud-scale pointer-events-none absolute inset-0 opacity-50"></div>

      {/* Scale leaping off where the hammer struck. */}
      <div class="pointer-events-none absolute inset-y-0 left-[6%] w-64" aria-hidden="true">
        {
          [
            { x: 34, y: -34, d: 620, t: 18, l: 20 },
            { x: 52, y: -50, d: 700, t: 40, l: 46 },
            { x: 26, y: -26, d: 780, t: 62, l: 8 },
            { x: 44, y: -42, d: 860, t: 30, l: 68 },
            { x: 30, y: -56, d: 940, t: 55, l: 88 },
          ].map((fleck) => (
            <span
              class="ud-shed absolute size-1.5 bg-[#0a0a0c]"
              style={`--shed-x:${fleck.x}px; --shed-y:${fleck.y}px; --ud-delay:${fleck.d}ms; top:${fleck.t}%; left:${fleck.l}%`}
            />
          ))
        }
      </div>

      <div
        class="ud-strike relative mx-auto flex max-w-[1600px] flex-wrap items-center gap-x-4 gap-y-3 px-4 py-6 sm:px-6 sm:py-8"
        style="--ud-delay: 300ms"
      >
        <a
          href="/json/formatter"
          class="ud-struck bg-stamp px-7 py-3.5 text-xl text-stamp-ink transition-opacity hover:opacity-85"
        >
          Strike some JSON
        </a>
        <a
          href="#stock"
          class="ud-struck border-2 border-stamp px-7 py-3.5 text-xl text-stamp transition-colors hover:bg-stamp hover:text-stamp-ink"
        >
          See the tools
        </a>
      </div>
    </div>

    {/* Registered measurement, exactly as the form keeps it. */}
    <div class="border-t border-scribe bg-ground">
      <ul class="mx-auto grid max-w-[1600px] sm:grid-cols-2 lg:grid-cols-4">
        {
          readout.map((item, index) => (
            <li
              class:list={[
                'border-scribe px-4 py-5 sm:px-6',
                index > 0 && 'border-t sm:border-t-0',
                index % 2 === 1 && 'sm:border-l',
                index >= 2 && 'sm:border-t lg:border-t-0',
                index > 0 && 'lg:border-l',
              ]}
            >
              <p class="flex items-baseline gap-2.5">
                <span class="ud-force text-3xl leading-none text-cherry sm:text-4xl">
                  {item.value}
                </span>
                <span class="ud-legend text-chalk">{item.label}</span>
              </p>
              <p class="mt-2.5 text-xs leading-relaxed text-temper">{item.note}</p>
            </li>
          ))
        }

        {/* Not a fourth figure, but how to go and check the other three. */}
        <li class="border-t border-scribe sm:border-l lg:border-t-0">
          <a
            href="/privacy"
            class="group flex h-full flex-col px-4 py-5 transition-colors hover:bg-bench sm:px-6"
          >
            <span class="ud-legend flex items-center gap-1.5 text-chalk">
              Check it yourself
              <Icon
                name="arrow-right"
                size={13}
                class="text-cherry transition-transform group-hover:translate-x-0.5"
              />
            </span>
            <span class="mt-2.5 text-xs leading-relaxed text-temper">
              Open your browser's Network panel and use any tool — not one request carries your
              document, because nothing ever reads it out of this tab.
            </span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  {/* THE RACK ----------------------------------------------------------- */}
  <section id="stock" class="mx-auto max-w-[1600px] scroll-mt-16 px-4 pt-16 sm:px-6 sm:pt-24">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b-2 border-scribe-strong pb-4">
      <h2 class="max-w-[22ch] text-[clamp(2rem,5vw,3.5rem)] text-chalk">
        Free JSON tools that run in your browser
      </h2>
      <a
        href="/json"
        class="ud-legend group flex items-center gap-1.5 transition-colors hover:text-chalk"
      >
        On the rack · {LIVE_TOOLS.length} drawn
        <Icon
          name="arrow-right"
          size={13}
          class="text-cherry transition-transform group-hover:translate-x-0.5"
        />
      </a>
    </div>

    <div>
      {TOOLS.map((tool, index) => <ToolRow tool={tool} index={index + 1} />)}
    </div>
  </section>

  {/* TEMPER ------------------------------------------------------------- */}
  <section class="mx-auto max-w-[1600px] px-4 pt-20 sm:px-6">
    <div class="grid gap-x-12 gap-y-10 md:grid-cols-3">
      {
        temper.map((item) => (
          <div class="border-t-2 border-cherry pt-5">
            <h3 class="ud-struck text-[1.6rem] text-chalk">{item.head}</h3>
            <p class="mt-3 text-sm leading-relaxed text-temper">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* THE CLOSE ---------------------------------------------------------- */}
  <section class="mt-20 border-y-2 border-scribe-strong bg-bench">
    <div class="ud-scale">
      <div
        class="mx-auto flex max-w-[1600px] flex-col items-start gap-6 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between"
      >
        <p class="ud-struck max-w-[20ch] text-[clamp(1.75rem,4vw,3rem)] text-chalk">
          Unplug the network. It still works.
        </p>
        <a
          href="/privacy"
          class="ud-struck shrink-0 border border-scribe-strong px-6 py-3 text-lg text-chalk transition-colors hover:border-cherry hover:text-cherry"
        >
          How that is true
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
