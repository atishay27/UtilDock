---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ToolCard from '../components/ToolCard.astro';
import { LIVE_TOOLS } from '../lib/tools';
---

<BaseLayout
  title="Page not found"
  description="That page does not exist on UtilDock."
  noindex
>
  <section class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-content sm:text-4xl">
      Nothing docked here
    </h1>
    <p class="mx-auto mt-4 max-w-md text-muted">
      That page does not exist — but one of these probably does what you came for.
    </p>

    <a
      href="/"
      class="mt-7 inline-flex items-center gap-2 rounded-lg border border-line bg-surface px-4 py-2.5 text-sm font-medium text-content transition-colors hover:border-line-strong"
    >
      <Icon name="arrow-right" size={16} class="rotate-180" />
      Back to the dock
    </a>

    <div class="mt-14 grid gap-4 text-left sm:grid-cols-2 lg:grid-cols-4">
      {LIVE_TOOLS.map((tool) => <ToolCard tool={tool} />)}
    </div>
  </section>
</BaseLayout>
