---
/**
 * Queues the Consent Mode defaults and, only once consent is stored, injects
 * the container. Renders nothing when no ID is configured, which is the local
 * and preview case.
 *
 * Lives in <head> so the defaults are in dataLayer before any Google code could
 * read them, so `window.utildock.consent` is readable by the time the banner
 * script runs, and so a returning visitor who already granted starts measuring
 * without waiting for the body to parse.
 *
 * The official GTM snippet is not pasted verbatim: Google's copy runs on parse,
 * this one on consent. Everything else — the gtm.start timing push, the async
 * insert — is the same.
 *
 * Its companion <noscript> iframe is omitted deliberately. It fires
 * unconditionally, which a JavaScript consent gate cannot govern, so it would
 * measure a JS-disabled visitor who was never asked. It would also need
 * frame-src in the CSP, and this site's tools do not run without JavaScript.
 */
import { GTM_ID, GA_ID, LOADER, CONSENT_KEY, ANALYTICS_ENABLED } from '../lib/analytics';
---

{
  ANALYTICS_ENABLED && (
    <script
      is:inline
      define:vars={{ loader: LOADER, gtmId: GTM_ID, gaId: GA_ID, consentKey: CONSENT_KEY }}
    >
      (function () {
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;

        /* Denied here and never updated anywhere. A tag added in the GTM
           console cannot raise these; the consent flow only touches
           analytics_storage. */
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
        });

        function inject(src) {
          var script = document.createElement('script');
          script.async = true;
          script.src = src;
          document.head.appendChild(script);
        }

        var loaded = false;
        function load() {
          if (loaded) return;
          loaded = true;

          if (loader === 'gtm') {
            window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            inject('https://www.googletagmanager.com/gtm.js?id=' + gtmId);
            return;
          }

          inject('https://www.googletagmanager.com/gtag/js?id=' + gaId);
          gtag('js', new Date());
          gtag('config', gaId, {
            anonymize_ip: true,
            allow_google_signals: false,
            allow_ad_personalization_signals: false,
          });
        }

        function stored() {
          try {
            return localStorage.getItem(consentKey);
          } catch (e) {
            /* Storage blocked: treat as undecided and never load. */
            return null;
          }
        }

        /* Every cookie GA4 writes is named _ga or _ga_<stream>. Clearing one
           needs the domain and path it was set with, and GA sets it on the
           registrable domain — which we cannot know from script, so expire it
           against the host and every parent of it. Unmatched attempts are
           no-ops; one of them lands.

           This runs on withdrawal *and* on every load of an already-denied
           page, which also sweeps up anything left by an earlier decision. */
        function clearCookies() {
          var jar = document.cookie ? document.cookie.split(';') : [];
          var names = [];
          for (var i = 0; i < jar.length; i++) {
            var name = jar[i].split('=')[0].trim();
            if (name.indexOf('_ga') === 0) names.push(name);
          }
          if (!names.length) return;

          var labels = location.hostname.split('.');
          var scopes = [''];
          for (var d = 0; d < labels.length - 1; d++) {
            scopes.push('; domain=.' + labels.slice(d).join('.'));
          }

          var dead = '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
          for (var n = 0; n < names.length; n++) {
            for (var s = 0; s < scopes.length; s++) {
              document.cookie = names[n] + dead + scopes[s];
            }
          }
        }

        /* The only path to a network request in this file. */
        function apply(state) {
          if (state === 'granted') {
            gtag('consent', 'update', { analytics_storage: 'granted' });
            load();
            return;
          }

          /* Withdrawal has to reach the tag that is already running in this
             page, not just the next one. Without this update GA4 keeps its
             cookie and keeps firing enhanced-measurement events until the
             visitor navigates, which is not what "off" means. */
          if (loaded) gtag('consent', 'update', { analytics_storage: 'denied' });
          clearCookies();
        }

        var api = (window.utildock = window.utildock || {});
        api.consent = stored();
        api.setConsent = function (state) {
          var value = state === 'granted' ? 'granted' : 'denied';
          try {
            localStorage.setItem(consentKey, value);
          } catch (e) {
            /* A visitor who cannot store a decision is left undecided, which
               means unmeasured. That is the safe direction to fail in. */
          }
          api.consent = value;
          apply(value);
          document.dispatchEvent(new CustomEvent('utildock:consent', { detail: value }));
        };

        apply(api.consent);
      })();
    </script>
  )
}
