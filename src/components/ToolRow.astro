---
import { splitName, type Tool } from '../lib/tools';

interface Props {
  tool: Tool;
  index: number;
  delay?: number;
}

const { tool, index, delay = 0 } = Astro.props;
const live = tool.status === 'live';
const Tag = live ? 'a' : 'div';
const number = String(index).padStart(2, '0');
/* The category was a separate chip; folded into the name so the row's link text
   is the full thing anyone would search for. */
const name = splitName(tool);
---

{/* One blow per full-width row. The row heats under the pointer. */}
<Tag
  href={live ? tool.href : undefined}
  class:list={[
    'group relative grid grid-cols-[3.5rem_1fr] items-baseline gap-x-4 gap-y-1 border-b border-scribe py-6 transition-colors sm:grid-cols-[5rem_minmax(0,16rem)_1fr] sm:gap-x-8 sm:py-7',
    live && 'hover:bg-anvil',
  ]}
>
  {/* Heat bar: the row's left edge comes to temperature on approach. */}
  {
    live && (
      <span class="ud-billet absolute top-0 bottom-0 left-0 w-[3px] origin-top scale-y-0 transition-transform duration-300 group-hover:scale-y-100" />
    )
  }

  <span
    class:list={[
      'ud-force self-center text-2xl leading-none transition-colors sm:text-[2.75rem]',
      live ? 'text-scribe-strong group-hover:text-cherry' : 'text-scribe-strong',
    ]}>{number}</span
  >

  <h3 class:list={['ud-struck text-2xl sm:text-[2rem]', live ? 'text-chalk' : 'text-temper']}>
    {name.prefix && <span class="text-faint">{name.prefix}</span>}{name.prefix && ' '}{name.rest}
  </h3>

  <p class="col-start-2 max-w-lg text-sm leading-relaxed text-temper sm:col-start-3 sm:pt-1.5">
    {tool.tagline}.
    {
      !live && (
        <span class="ud-legend ml-1 border border-scribe px-1.5 py-0.5 align-middle">
          cold stock
        </span>
      )
    }
  </p>
</Tag>
