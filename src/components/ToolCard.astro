---
import type { Tool } from '../lib/tools';
import Icon from './Icon.astro';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const isLive = tool.status === 'live';
const Tag = isLive ? 'a' : 'div';
---

<Tag
  href={isLive ? tool.href : undefined}
  class:list={[
    'group relative flex flex-col rounded-xl border border-line bg-surface p-5 transition-all',
    isLive
      ? 'hover:-translate-y-0.5 hover:border-accent/50 hover:bg-surface-2 hover:shadow-lg hover:shadow-black/20'
      : 'opacity-60',
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <span
      class:list={[
        'grid size-10 place-items-center rounded-lg border transition-colors',
        isLive
          ? 'border-line-strong bg-surface-2 text-accent group-hover:border-accent/60'
          : 'border-line bg-surface-2 text-faint',
      ]}
    >
      <Icon name={tool.icon} size={20} />
    </span>
    {
      isLive ? (
        <Icon
          name="arrow-right"
          size={17}
          class="mt-1 text-faint transition-all group-hover:translate-x-0.5 group-hover:text-accent"
        />
      ) : (
        <span class="mt-1 rounded-full border border-line px-2 py-0.5 text-[11px] text-faint">
          soon
        </span>
      )
    }
  </div>

  <h3 class="mt-4 font-semibold text-content">{tool.name}</h3>
  <p class="mt-1.5 text-sm leading-relaxed text-muted">{tool.tagline}</p>
</Tag>
