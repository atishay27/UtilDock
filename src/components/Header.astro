---
/**
 * Category-grouped navigation.
 *
 * The bar names categories, not tools: "JSON tools" opens a panel of the four
 * under their full names. A flat list would not say which format each works on,
 * and would grow into the logo as the dock does.
 *
 * Categories come from the registry, so a new one adds a menu with no edit here.
 * A category with nothing live renders as a marker rather than a trigger.
 */
import { toolsInCategory } from '../lib/tools';
import { href, localizedCategories, localizedTools, t } from '../lib/i18n';
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_IDS,
  localizedPath,
  rootPath,
  type Locale,
} from '../lib/i18n/locales';
import { fill } from '../lib/i18n/format';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageMenu from './LanguageMenu.astro';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = t(locale);

/* Compared against the registry's unprefixed hrefs, so the active-tool marker
   works the same on /json/viewer and on /es/json/viewer. */
const path = rootPath(Astro.url.pathname).replace(/\/$/, '');

const menus = localizedCategories(locale).map((category) => {
  const tools = localizedTools(toolsInCategory(category.id), locale);
  return {
    category,
    live: tools.filter((tool) => tool.status === 'live'),
    planned: tools.filter((tool) => tool.status !== 'live'),
  };
});
---

<header class="sticky top-0 z-40 border-b border-scribe bg-ground">
  <div class="mx-auto flex h-14 max-w-[1600px] items-center gap-2 px-4 sm:px-6">
    <a
      href={href('/', locale)}
      class="ud-struck flex h-11 shrink-0 items-center gap-2.5 text-[1.35rem] text-chalk"
      aria-label={ui.chrome.homeAria}
    >
      <Logo size={24} />
      UtilDock
    </a>

    <nav aria-label={ui.chrome.navTools} class="ml-4 hidden items-center gap-1 md:flex">
      {
        menus.map(({ category, live, planned }) => {
          /* Derived from the tools as well as the hub, so a category without a
             hub page still lights up on its own tool's page. */
          const within = [category.href, ...live.map((tool) => tool.href)].some(
            (candidate) => candidate !== undefined && path.startsWith(candidate),
          );

          if (live.length === 0) {
            return (
              <span class="ud-legend flex items-center gap-2 px-3 py-2 text-faint">
                {category.name}
                <span class="border border-scribe px-1.5 py-0.5 text-faint">{ui.chrome.soon}</span>
              </span>
            );
          }

          return (
            <div class="ud-menu relative" data-menu>
              <button
                type="button"
                data-menu-trigger
                aria-haspopup="true"
                aria-expanded="false"
                class:list={[
                  'ud-legend flex items-center gap-1.5 px-3 py-2 transition-colors',
                  within ? 'text-chalk' : 'text-temper hover:text-chalk',
                ]}
              >
                {fill(ui.chrome.categoryTools, { category: category.name })}
                <Icon name="chevron-down" size={12} class="ud-menu-caret transition-transform" />
              </button>

              <div
                data-menu-panel
                hidden
                class="ud-menu-panel absolute top-full left-0 w-[23rem] border-2 border-scribe-strong bg-anvil"
              >
                <p class="ud-legend border-b border-scribe bg-bench px-4 py-2.5 text-faint">
                  {category.blurb}
                </p>

                <ul>
                  {live.map((tool) => {
                    const active = path === tool.href;
                    return (
                      <li>
                        <a
                          href={href(tool.href, locale)}
                          aria-current={active ? 'page' : undefined}
                          class:list={[
                            'group relative flex items-start gap-3 border-b border-scribe px-4 py-3 transition-colors hover:bg-anvil-lit',
                            /* anvil-lit alone is a 5-value lift in the light
                               theme — invisible. The edge carries it instead. */
                            active && 'bg-bench',
                          ]}
                        >
                          {active && <span class="absolute inset-y-0 left-0 w-[2px] bg-cherry" />}
                          <Icon
                            name={tool.icon}
                            size={17}
                            class:list={[
                              'mt-0.5 shrink-0 transition-colors',
                              active ? 'text-cherry' : 'text-faint group-hover:text-cherry',
                            ]}
                          />
                          <span class="min-w-0">
                            <span class="ud-struck block text-[1.05rem] text-chalk">
                              {tool.name}
                            </span>
                            <span class="mt-0.5 block text-xs leading-snug text-temper">
                              {tool.tagline}
                            </span>
                          </span>
                        </a>
                      </li>
                    );
                  })}

                  {planned.map((tool) => (
                    <li class="flex items-center gap-3 border-b border-scribe px-4 py-2.5">
                      <Icon name={tool.icon} size={17} class="shrink-0 text-scribe-strong" />
                      <span class="ud-struck text-[1.05rem] text-faint">{tool.name}</span>
                      <span class="ud-legend ml-auto text-faint">{ui.chrome.soon}</span>
                    </li>
                  ))}
                </ul>

                {category.href && (
                  <a
                    href={href(category.href, locale)}
                    class="ud-legend group flex items-center gap-1.5 px-4 py-3 text-temper transition-colors hover:text-chalk"
                  >
                    {fill(ui.chrome.allCategoryTools, { category: category.name })}
                    <Icon
                      name="arrow-right"
                      size={12}
                      class="text-cherry transition-transform group-hover:translate-x-0.5"
                    />
                  </a>
                )}
              </div>
            </div>
          );
        })
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      {/* A link, not a badge. The outer element is the 44px target; the inner
          one is the visible box, sized to match ThemeToggle. Bordering the
          target itself would draw an 11-high box beside the toggle's 8. */}
      <a href={href('/privacy', locale)} class="hidden h-11 items-center lg:inline-flex">
        <span
          class="ud-legend flex h-8 items-center gap-2 border border-scribe px-2.5 text-temper transition-colors hover:border-cherry hover:text-chalk"
        >
          <Icon name="lock" size={12} class="shrink-0 text-sound" />
          {ui.chrome.privacyPill}
        </span>
      </a>
      {/* Hidden below md, where the mobile panel carries it instead — a third
          control does not fit a 390px bar. */}
      <div class="hidden md:block"><LanguageMenu locale={locale} /></div>
      <ThemeToggle locale={locale} />
      <button
        id="nav-toggle"
        type="button"
        class="ud-legend group flex h-11 items-center gap-1.5 border border-scribe px-3 text-temper transition-colors hover:border-cherry hover:text-chalk md:hidden"
        aria-label={ui.chrome.openToolsMenu}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        {/* The icon states what the next tap does, matching the label. */}
        <span class="contents group-[[aria-expanded=true]]:hidden"><Icon name="menu" size={14} /></span>
        <span class="hidden group-[[aria-expanded=true]]:contents"><Icon name="x" size={14} /></span>
        {ui.chrome.toolsButton}
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label={ui.chrome.navTools} class="hidden border-t border-scribe bg-anvil md:hidden">
    {
      menus.map(({ category, live, planned }) => (
        <div>
          <p class="ud-legend flex items-center gap-2 border-b border-scribe bg-bench px-4 py-2 text-faint">
            {category.name}
            {live.length === 0 && (
              <span class="border border-scribe px-1.5 py-0.5">{ui.chrome.soon}</span>
            )}
          </p>

          {live.map((tool) => (
            <a
              href={href(tool.href, locale)}
              aria-current={path === tool.href ? 'page' : undefined}
              class:list={[
                'relative flex min-h-11 items-center gap-3 border-b border-scribe px-4 py-3',
                path === tool.href && 'bg-bench',
              ]}
            >
              {path === tool.href && <span class="absolute inset-y-0 left-0 w-[2px] bg-cherry" />}
              <Icon
                name={tool.icon}
                size={17}
                class:list={['shrink-0', path === tool.href ? 'text-cherry' : 'text-faint']}
              />
              <span class="ud-struck text-[1.05rem] text-chalk">{tool.name}</span>
            </a>
          ))}

          {planned.map((tool) => (
            <span class="flex min-h-11 items-center gap-3 border-b border-scribe px-4 py-3">
              <Icon name={tool.icon} size={17} class="shrink-0 text-scribe-strong" />
              <span class="ud-struck text-[1.05rem] text-faint">{tool.name}</span>
              <span class="ud-legend ml-auto text-faint">{ui.chrome.soon}</span>
            </span>
          ))}
        </div>
      ))
    }

    {/* Native names, not codes: this is the one control someone may be reaching
        for precisely because they cannot read the words around it. */}
    <p class="ud-legend flex items-center gap-2 border-b border-scribe bg-bench px-4 py-2 text-faint">
      {ui.footer.language}
    </p>
    <ul class="flex flex-wrap gap-x-1 gap-y-1 border-b border-scribe px-3 py-3">
      {
        LOCALE_IDS.map((id) => {
          const meta = LOCALES[id];
          const active = id === locale;
          return (
            <li>
              <a
                href={localizedPath(rootPath(Astro.url.pathname), id)}
                hreflang={meta.hreflang}
                lang={meta.hreflang}
                aria-current={active ? 'true' : undefined}
                class:list={[
                  'flex min-h-11 items-center border px-3 text-sm transition-colors',
                  active
                    ? 'border-cherry text-chalk'
                    : 'border-scribe text-temper hover:border-scribe-strong hover:text-chalk',
                ]}
              >
                {meta.native}
              </a>
            </li>
          );
        })
      }
    </ul>

    <a
      href={href('/privacy', locale)}
      class="ud-legend flex min-h-11 items-center gap-2 px-4 py-3 text-temper transition-colors hover:text-chalk"
    >
      <Icon name="lock" size={12} class="shrink-0 text-sound" />
      {ui.chrome.privacyPillMobile}
    </a>
  </nav>
</header>

<script>
  /* Desktop menus open on hover and on click.
   *
   * Hover is gated on a device that has one: a touchscreen synthesises
   * mouseenter before click, so an ungated handler opens the panel and the
   * click closes it again.
   *
   * The delays make the pointer's path forgiving — opening ignores a pointer
   * merely crossing the header, closing allows time to cross the seam and sweep
   * diagonally. Switching between open panels is instant.
   */
  const menus = [...document.querySelectorAll<HTMLElement>('[data-menu]')];
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const OPEN_DELAY = 110;
  const CLOSE_DELAY = 220;
  let openTimer: number | undefined;
  let closeTimer: number | undefined;

  function clearTimers() {
    window.clearTimeout(openTimer);
    window.clearTimeout(closeTimer);
  }

  function panelOf(menu: HTMLElement) {
    return menu.querySelector<HTMLElement>('[data-menu-panel]');
  }

  function setOpen(menu: HTMLElement, open: boolean) {
    const panel = panelOf(menu);
    const trigger = menu.querySelector<HTMLElement>('[data-menu-trigger]');
    if (!panel || !trigger) return;
    panel.hidden = !open;
    menu.dataset.open = open ? 'true' : 'false';
    trigger.setAttribute('aria-expanded', String(open));
  }

  function closeAll() {
    menus.forEach((menu) => setOpen(menu, false));
  }

  const anyOpen = () => menus.some((menu) => menu.dataset.open === 'true');

  menus.forEach((menu) => {
    const trigger = menu.querySelector<HTMLElement>('[data-menu-trigger]');

    trigger?.addEventListener('click', (event) => {
      event.stopPropagation();
      clearTimers();
      const open = menu.dataset.open === 'true';
      closeAll();
      setOpen(menu, !open);
    });

    if (!canHover) return;

    menu.addEventListener('mouseenter', () => {
      clearTimers();
      if (menu.dataset.open === 'true') return;
      openTimer = window.setTimeout(
        () => {
          closeAll();
          setOpen(menu, true);
        },
        anyOpen() ? 0 : OPEN_DELAY,
      );
    });

    menu.addEventListener('mouseleave', () => {
      clearTimers();
      closeTimer = window.setTimeout(closeAll, CLOSE_DELAY);
    });
  });

  document.addEventListener('click', (event) => {
    if (!(event.target as HTMLElement).closest('[data-menu]')) closeAll();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !anyOpen()) return;
    clearTimers();
    const open = menus.find((menu) => menu.dataset.open === 'true');
    closeAll();
    open?.querySelector<HTMLElement>('[data-menu-trigger]')?.focus();
  });

  /* Focus leaving the menu entirely closes it, so tabbing past the last item
     does not leave a panel hanging open behind the page. */
  document.addEventListener('focusin', (event) => {
    if (!(event.target as HTMLElement).closest('[data-menu]')) closeAll();
  });

  const button = document.getElementById('nav-toggle');
  const nav = document.getElementById('mobile-nav');

  function setDrawer(open: boolean) {
    nav?.classList.toggle('hidden', !open);
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? 'Close tools menu' : 'Open tools menu');
  }

  button?.addEventListener('click', () => setDrawer(nav?.classList.contains('hidden') === true));

  /* Escape closes the drawer too, not just the desktop menus — otherwise a
     keyboard user on a narrow window has to hunt for the toggle. */
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || nav?.classList.contains('hidden') !== false) return;
    setDrawer(false);
    button?.focus();
  });
</script>

<style>
  .ud-menu-panel {
    transform: translateY(-4px);
    opacity: 0;
    transition:
      opacity 140ms ease-out,
      transform 140ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .ud-menu[data-open='true'] .ud-menu-panel {
    transform: translateY(0);
    opacity: 1;
  }

  .ud-menu[data-open='true'] .ud-menu-caret {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .ud-menu-panel {
      transition: none;
    }
  }
</style>
