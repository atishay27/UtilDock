---
import { LIVE_TOOLS } from '../lib/tools';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/$/, '');
---

<header class="sticky top-0 z-40 border-b border-scribe bg-ground">
  <div class="mx-auto flex h-14 max-w-[1600px] items-center gap-4 px-4 sm:px-6">
    <a
      href="/"
      class="ud-struck flex shrink-0 items-center gap-2.5 text-[1.35rem] text-chalk"
      aria-label="UtilDock home"
    >
      <Logo size={24} />
      UtilDock
    </a>

    <nav aria-label="Tools" class="ml-3 hidden items-center md:flex">
      {
        LIVE_TOOLS.map((tool) => {
          const active = path === tool.href;
          return (
            <a
              href={tool.href}
              class:list={[
                'ud-legend relative px-3 py-4 transition-colors',
                active ? 'text-chalk' : 'hover:text-chalk',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {tool.name.replace('JSON ', '')}
              {active && <span class="absolute inset-x-2 bottom-0 h-0.5 bg-cherry" />}
            </a>
          );
        })
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <span class="ud-legend hidden items-center gap-2 border border-scribe px-2.5 py-1.5 lg:inline-flex">
        <span class="size-1.5 shrink-0 bg-sound"></span>
        Nothing leaves the shop
      </span>
      <ThemeToggle />
      <button
        id="nav-toggle"
        type="button"
        class="ud-legend flex h-8 items-center border border-scribe px-2.5 text-faint transition-colors hover:text-chalk md:hidden"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        Tools
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Tools" class="hidden border-t border-scribe md:hidden">
    {
      LIVE_TOOLS.map((tool) => (
        <a
          href={tool.href}
          class:list={[
            'ud-legend block border-b border-scribe px-4 py-3',
            path === tool.href ? 'bg-anvil text-chalk' : '',
          ]}
        >
          {tool.name}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const button = document.getElementById('nav-toggle');
  const nav = document.getElementById('mobile-nav');
  button?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    button.setAttribute('aria-expanded', String(open));
  });
</script>
