---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import Rich from '../Rich.astro';
import { LIVE_TOOLS } from '../../lib/tools';
import { SITE, absoluteUrl } from '../../lib/site';
import { breadcrumbNode, WEBSITE_ID } from '../../lib/seo';
import { href, langTag, localizedTools, t } from '../../lib/i18n';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../../lib/i18n/locales';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = t(locale);
const tools = localizedTools(LIVE_TOOLS, locale);
const url = absoluteUrl(localizedPath('/about', locale));

const schema = [
  {
    '@type': 'AboutPage',
    '@id': url,
    name: `${ui.about.heading} — ${SITE.name}`,
    url,
    description: ui.about.description,
    inLanguage: langTag(locale),
    isPartOf: { '@id': WEBSITE_ID },
  },
  breadcrumbNode(
    [
      { name: ui.chrome.home, path: '/' },
      { name: ui.about.heading, path: '/about' },
    ],
    locale,
  ),
];
---

<BaseLayout
  title={ui.about.title}
  description={ui.about.description}
  schema={schema}
  locale={locale}
>
  <article class="ud-prose mx-auto max-w-2xl px-4 py-14 sm:px-6">
    <nav aria-label={ui.chrome.breadcrumb} class="ud-legend flex items-center gap-2">
      <a href={href('/', locale)} class="transition-colors hover:text-chalk">{ui.chrome.home}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{ui.about.heading}</span>
    </nav>
    <h1 class="mt-3 text-[clamp(1.9rem,4.5vw,3rem)] text-chalk">{ui.about.heading}</h1>
    <p class="mt-4 text-lg leading-relaxed text-temper">{ui.footer.tagline}</p>

    <div class="mt-10 space-y-8 text-sm leading-relaxed text-temper">
      <section>
        <h2 class="text-lg font-semibold text-chalk">{ui.about.whyHeading}</h2>
        {ui.about.why.map((paragraph) => <p class="mt-3">{paragraph}</p>)}
      </section>

      <section>
        <h2 class="text-lg font-semibold text-chalk">{ui.about.builtHeading}</h2>
        {
          ui.about.built.map((paragraph) => (
            <p class="mt-3">
              <Rich text={paragraph} locale={locale} />
            </p>
          ))
        }
      </section>

      <section>
        <h2 class="text-lg font-semibold text-chalk">{ui.about.todayHeading}</h2>
        {/* Hairline rows, not a grid of bordered boxes. DESIGN.md forbids
            rebuilding the tool directory as a card grid. The tagline earns the
            row its place: this list says something the homepage directory does
            not repeat verbatim. */}
        <ul class="mt-4 border-t border-scribe">
          {
            tools.map((tool) => (
              <li>
                <a
                  href={href(tool.href, locale)}
                  class="group flex items-baseline gap-3 border-b border-scribe py-3 transition-colors hover:bg-anvil"
                >
                  <Icon
                    name={tool.icon}
                    size={15}
                    class="shrink-0 translate-y-0.5 text-faint transition-colors group-hover:text-cherry"
                  />
                  <span class="text-chalk">{tool.name}</span>
                  <span class="text-xs text-faint">{tool.tagline}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-4">{ui.about.today}</p>
      </section>
    </div>
  </article>
</BaseLayout>
