---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import Rich from '../Rich.astro';
import { ANALYTICS_ENABLED } from '../../lib/analytics';
import { t } from '../../lib/i18n';
import { DEFAULT_LOCALE, type Locale } from '../../lib/i18n/locales';
import { fill } from '../../lib/i18n/format';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = t(locale);
const translated = locale !== DEFAULT_LOCALE;
---

<BaseLayout title={ui.privacy.title} description={ui.privacy.description} locale={locale}>
  <article class="ud-prose mx-auto max-w-2xl px-4 py-14 sm:px-6">
    <h1 class="text-[clamp(1.9rem,4.5vw,3rem)] text-chalk">{ui.privacy.heading}</h1>
    <p class="mt-2 text-sm text-faint">
      {fill(ui.privacy.updated, { date: ui.privacy.updatedDate })}
    </p>

    {/*
      A privacy policy is the one page where a translator's slip stops being a
      clumsy sentence and becomes a false statement about what the software
      does. The translation is offered because a policy nobody can read protects
      nobody; the English is what governs, and saying so is the honest way to
      have both.
    */}
    {
      translated && (
        <p class="mt-4 border-l-2 border-scribe-strong pl-3 text-xs leading-relaxed text-faint">
          {ui.privacy.translationNote}
        </p>
      )
    }

    <div class="mt-8 flex items-start gap-3 border border-sound/30 bg-sound/8 p-4 sm:p-5">
      <Icon name="lock" size={19} class="mt-0.5 shrink-0 text-sound" />
      <p class="text-sm leading-relaxed text-chalk">
        <Rich text={ui.privacy.lead} locale={locale} strong="font-semibold" />
      </p>
    </div>

    <div class="mt-10 space-y-8 text-sm leading-relaxed text-temper">
      <section>
        <h2 class="text-lg font-semibold text-chalk">{ui.privacy.howHeading}</h2>
        {
          ui.privacy.how.map((paragraph) => (
            <p class="mt-3">
              <Rich text={paragraph} locale={locale} />
            </p>
          ))
        }
      </section>

      <section>
        <h2 class="text-lg font-semibold text-chalk">{ui.privacy.storedHeading}</h2>
        <p class="mt-3"><Rich text={ui.privacy.stored} locale={locale} /></p>
        {
          /* The consent decision is stored the same way. A policy that
             enumerates what it keeps has to enumerate all of it. */
          ANALYTICS_ENABLED && <p class="mt-3">{ui.privacy.storedConsent}</p>
        }
      </section>

      {/*
        Both this section and the choices below follow the build. They used to
        be written as though analytics were always on, while the footer control
        that operates it renders only when it is. A dead control in a privacy
        policy is worse than an ugly one: the page's whole job is to be accurate.
      */}
      <section id="analytics" class="scroll-mt-24">
        <h2 class="text-lg font-semibold text-chalk">{ui.privacy.analyticsHeading}</h2>
        {
          ANALYTICS_ENABLED ? (
            ui.privacy.analyticsOn.map((paragraph) => (
              <p class="mt-3">
                <Rich text={paragraph} locale={locale} />
              </p>
            ))
          ) : (
            <p class="mt-3">{ui.privacy.analyticsOff}</p>
          )
        }
        <p class="mt-3">{ui.privacy.analyticsNever}</p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-chalk">{ui.privacy.choicesHeading}</h2>
        {/* This is itself the control it describes. Say what the thing does,
            and let the sentence run. */}
        {
          ANALYTICS_ENABLED && (
            <>
              <p class="mt-3">
                {ui.privacy.choicesLead}{' '}
                <button
                  type="button"
                  data-consent-open
                  class="text-cherry underline underline-offset-4 hover:no-underline"
                >
                  {ui.privacy.choicesButton}
                </button>{' '}
                {ui.privacy.choicesRest}
              </p>
              <p class="mt-3">
                <Rich text={ui.privacy.choicesImmediate} locale={locale} />
              </p>
            </>
          )
        }
        <p class="mt-3">{ui.privacy.choicesUngated}</p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-chalk">{ui.privacy.hostingHeading}</h2>
        <p class="mt-3"><Rich text={ui.privacy.hosting} locale={locale} /></p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-chalk">{ui.privacy.securityHeading}</h2>
        {
          ui.privacy.security.map((paragraph) => (
            <p class="mt-3">
              <Rich text={paragraph} locale={locale} />
            </p>
          ))
        }
      </section>

      <section>
        <h2 class="text-lg font-semibold text-chalk">{ui.privacy.childrenHeading}</h2>
        <p class="mt-3">{ui.privacy.children}</p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-chalk">{ui.privacy.changesHeading}</h2>
        <p class="mt-3">{ui.privacy.changes}</p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-chalk">{ui.privacy.contactHeading}</h2>
        <p class="mt-3"><Rich text={ui.privacy.contact} locale={locale} /></p>
      </section>
    </div>
  </article>
</BaseLayout>
