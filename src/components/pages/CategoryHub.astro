---
/* One hub per category, built entirely from the registry and the `hub`
   dictionary. A new category gets a hub by adding an `href` in tools.ts and a
   copy block in the dictionaries — no new component. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolRow from '../ToolRow.astro';
import Icon from '../Icon.astro';
import Rich from '../Rich.astro';
import { getCategory, toolsInCategory, type CategoryId } from '../../lib/tools';
import { SITE, absoluteUrl } from '../../lib/site';
import { breadcrumbNode, itemListNode, WEBSITE_ID } from '../../lib/seo';
import { href, langTag, localizedCategory, localizedTools, t } from '../../lib/i18n';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../../lib/i18n/locales';
import { plural } from '../../lib/i18n/format';

interface Props {
  category: CategoryId;
  locale?: Locale;
}

const { category: categoryId, locale = DEFAULT_LOCALE } = Astro.props;
const ui = t(locale);
const hub = ui.hub;
const copy = hub.categories[categoryId];

const category = localizedCategory(getCategory(categoryId), locale);
const tools = localizedTools(toolsInCategory(categoryId), locale);
const live = tools.filter((tool) => tool.status === 'live');
const path = category.href ?? `/${categoryId}`;
const url = absoluteUrl(localizedPath(path, locale));

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': url,
    name: `${category.name} — ${SITE.name}`,
    url,
    description: copy.description,
    inLanguage: langTag(locale),
    isPartOf: { '@id': WEBSITE_ID },
  },
  itemListNode(
    category.name,
    live.map((tool) => ({ name: tool.name, description: tool.tagline, href: tool.href })),
    locale,
  ),
  breadcrumbNode(
    [
      { name: ui.chrome.home, path: '/' },
      { name: category.name, path },
    ],
    locale,
  ),
];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  keywords={copy.keywords}
  schema={schema}
  locale={locale}
>
  <section class="ud-scale border-b border-scribe">
    <div class="mx-auto max-w-[1600px] px-4 pt-14 pb-12 sm:px-6 sm:pt-20">
      <nav aria-label={ui.chrome.breadcrumb} class="ud-legend flex items-center gap-2">
        <a href={href('/', locale)} class="transition-colors hover:text-chalk">{ui.chrome.home}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{category.name}</span>
      </nav>

      <h1 class="mt-3 max-w-[18ch] text-[clamp(2.75rem,8vw,6rem)] text-chalk">
        {copy.headlineLead} <span class="text-cherry">{copy.headlineAccent}</span>
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-temper">
        <Rich
          text={copy.lede}
          locale={locale}
          link="text-chalk underline decoration-scribe-strong underline-offset-4 transition-colors hover:text-cherry"
        />
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1600px] px-4 pt-14 sm:px-6">
    <div
      class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b-2 border-scribe-strong pb-4"
    >
      <h2 class="text-[clamp(1.9rem,4.5vw,3rem)] text-chalk">{hub.chooseHeading}</h2>
      <p class="ud-legend">{plural(langTag(locale), hub.toolCount, live.length)}</p>
    </div>

    <div>
      {tools.map((tool) => <ToolRow tool={tool} locale={locale} />)}
    </div>
  </section>

  <section class="mx-auto max-w-[1600px] px-4 pt-16 pb-4 sm:px-6">
    <div class="grid gap-x-12 gap-y-10 md:grid-cols-3">
      {
        [...hub.notes, copy.note].map((note) => (
          <div class="border-t-2 border-cherry pt-5">
            <h2 class="ud-struck text-[1.6rem] text-chalk">{note.head}</h2>
            <p class="mt-3 text-sm leading-relaxed text-temper">{note.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-16 border-y-2 border-scribe-strong bg-bench">
    <div class="ud-scale">
      <div
        class="mx-auto flex max-w-[1600px] flex-col items-start gap-6 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between"
      >
        <p class="ud-struck max-w-[24ch] text-[clamp(1.6rem,3.5vw,2.5rem)] text-chalk">
          {hub.closeLine}
        </p>
        <a
          href={href('/privacy', locale)}
          class="ud-struck flex shrink-0 items-center gap-2 border border-scribe-strong px-6 py-3 text-lg text-chalk transition-colors hover:border-cherry hover:text-cherry"
        >
          {hub.closeCta}
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
