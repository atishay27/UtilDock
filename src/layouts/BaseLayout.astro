---
import '../styles/global.css';
import { SITE } from '../lib/site';
import { FONT_PRELOADS } from '../lib/fonts';
import { graph } from '../lib/seo';
import { alternates, defaultAlternate, t } from '../lib/i18n';
import { DEFAULT_LOCALE, LOCALES, rootPath, type Locale } from '../lib/i18n/locales';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  keywords?: string[];
  /** Page-specific JSON-LD nodes. Organization and WebSite are added here. */
  schema?: unknown[];
  noindex?: boolean;
  locale?: Locale;
}

const {
  title,
  description,
  canonical,
  keywords = [],
  schema = [],
  noindex = false,
  locale = DEFAULT_LOCALE,
} = Astro.props;

const ui = t(locale);
const meta = LOCALES[locale];

/* The same page in every language, addressed from its unprefixed path. Emitted
   on every locale including English, because hreflang is only honoured when the
   set is reciprocal — a page that lists alternates but is not listed back by
   them is dropped from the cluster entirely. */
const root = rootPath(Astro.url.pathname);
const localeAlternates = noindex ? [] : alternates(root);

/* The sitemap emits directory URLs, so the canonical has to agree with it or the
   two disagree about which of /json/diff and /json/diff/ is the real page. */
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = canonical ?? new URL(path, SITE.url).href;
/* A title that already names the site does not get it a second time. */
const fullTitle = title.startsWith(SITE.name) ? title : `${title} | ${SITE.name}`;
const ogImage = new URL('/og-default.png', SITE.url).href;
const ogImageAlt = `${SITE.name} — ${SITE.tagline}`;

/* A page excluded from the index has nothing to say to a crawler. */
const structuredData = noindex ? undefined : graph(schema);
---

<!doctype html>
<html lang={meta.hreflang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      localeAlternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
      ))
    }
    {
      localeAlternates.length > 0 && (
        <link rel="alternate" hreflang="x-default" href={defaultAlternate(root)} />
      )
    }
    <meta id="theme-color" name="theme-color" content="#0a0a0c" />

    {/* Self-hosted; the display face carries the first viewport, so it leads.
        Names and order come from scripts/fetch-fonts.mjs — they carry a content
        hash now, so they cannot be written here by hand. */}
    {
      FONT_PRELOADS.map((font) => (
        <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
      ))
    }

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('utildock:theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
            document.documentElement.dataset.theme = 'light';
          }
          // Browser chrome follows the shop, or a light page gets a black bar.
          var meta = document.getElementById('theme-color');
          if (meta && document.documentElement.dataset.theme === 'light') {
            meta.setAttribute('content', '#e5e2dc');
          }
        } catch (e) {
          /* keep the forge dark */
        }
      })();
    </script>

    <Analytics />

    {
      structuredData && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
      )
    }
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-cherry focus:px-4 focus:py-2 focus:font-semibold focus:text-on-cherry"
    >
      {ui.chrome.skipToContent}
    </a>
    <Header locale={locale} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <ConsentBanner locale={locale} />

    <script is:inline>
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
