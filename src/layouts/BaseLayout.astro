---
import '../styles/global.css';
import { SITE } from '../lib/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  keywords?: string[];
  structuredData?: unknown;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  keywords = [],
  structuredData,
  noindex = false,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const ogImage = new URL('/og-default.png', SITE.url).href;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta id="theme-color" name="theme-color" content="#0a0a0c" />

    <!-- Self-hosted; the display face carries the first viewport, so it leads. -->
    <link rel="preload" href="/fonts/bigshoulders.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('utildock:theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.dataset.theme = stored;
          } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
            document.documentElement.dataset.theme = 'light';
          }
          // Browser chrome follows the shop, or a light page gets a black bar.
          var meta = document.getElementById('theme-color');
          if (meta && document.documentElement.dataset.theme === 'light') {
            meta.setAttribute('content', '#e5e2dc');
          }
        } catch (e) {
          /* keep the forge dark */
        }
      })();
    </script>

    {
      structuredData && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
      )
    }
  </head>

  <body class="flex min-h-screen flex-col">
    <!--
      THESIS: A forge, not a dashboard. Stock is heated, struck, measured — and never leaves the
      shop. Refuses the dark-page-with-one-neon-accent tool template this category always ships.
      OWN-WORLD: A heat scale carrying state (cold, dull red, cherry, white heat) over forge black
      or cold mill-scale concrete; stencilled condensed caps; tabular force numerals; scale-fleck
      texture; scribed hairlines. No glass, no gradient chrome, no rounded pill cards.
      STORY: A developer forbidden from pasting production data into a website learns the billet
      never leaves their own anvil, watches it proven, and starts work.
      FIRST VIEWPORT: Full-bleed struck headline over a heat-graded billet; measurement readout
      registered beneath it; the primary action struck into hot metal on the billet's own row.
      FORM: "Scale Shower" (forging), chosen by the user over assigned index 7; seed 2b1ba07a.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-cherry focus:px-4 focus:py-2 focus:font-semibold focus:text-on-cherry"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
