---
import BaseLayout from './BaseLayout.astro';
import Rich from '../components/Rich.astro';
import { SITE, absoluteUrl } from '../lib/site';
import { getCategory, getTool, relatedTools, splitName } from '../lib/tools';
import { breadcrumbNode, ORGANIZATION_ID, WEBSITE_ID } from '../lib/seo';
import { href, langTag, localizedCategory, localizedTool, localizedTools, t } from '../lib/i18n';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../lib/i18n/locales';
import { fill } from '../lib/i18n/format';
import Icon from '../components/Icon.astro';

interface Props {
  toolId: string;
  locale?: Locale;
}

const { toolId, locale = DEFAULT_LOCALE } = Astro.props;
const ui = t(locale);
const tool = localizedTool(getTool(toolId), locale);
const category = localizedCategory(getCategory(tool.category), locale);
const related = localizedTools(relatedTools(tool.id), locale);

/* The localised URL, not the English one: a Spanish page that names the English
   address merges the two in the index and stops being a result of its own. */
const url = absoluteUrl(localizedPath(tool.href, locale));
const name = splitName(tool);
const faqs = tool.faqs ?? [];
const about = ui.toolAbout[tool.id as keyof typeof ui.toolAbout];

const schema = [
  {
    '@type': 'SoftwareApplication',
    name: `${tool.name} — ${SITE.name}`,
    url,
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'Online tool',
    operatingSystem: 'Any',
    description: tool.description,
    inLanguage: langTag(locale),
    browserRequirements: 'Requires JavaScript',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isAccessibleForFree: true,
    featureList: tool.keywords,
    publisher: { '@id': ORGANIZATION_ID },
    isPartOf: { '@id': WEBSITE_ID },
  },
  breadcrumbNode(
    [
      { name: ui.chrome.home, path: '/' },
      ...(category.href ? [{ name: category.name, path: category.href }] : []),
      { name: tool.name, path: tool.href },
    ],
    locale,
  ),
  ...(faqs.length > 0
    ? [
        {
          '@type': 'FAQPage',
          inLanguage: langTag(locale),
          mainEntity: faqs.map((faq) => ({
            '@type': 'Question',
            name: faq.q,
            acceptedAnswer: { '@type': 'Answer', text: faq.a },
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={tool.title}
  description={tool.description}
  keywords={tool.keywords}
  schema={schema}
  locale={locale}
>
  <div class="mx-auto max-w-[1600px] px-4 pt-5 pb-10 sm:px-6">
    {/* The workpiece plate: name, and what this station does. */}
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3 border-b-2 border-scribe-strong pb-4">
      <div>
        <nav aria-label={ui.chrome.breadcrumb} class="ud-legend flex items-center gap-2">
          <a href={href('/', locale)} class="transition-colors hover:text-chalk">{ui.chrome.home}</a>
          <span aria-hidden="true">/</span>
          {
            category.href ? (
              <a href={href(category.href, locale)} class="transition-colors hover:text-chalk">
                {category.name}
              </a>
            ) : (
              <span>{category.name}</span>
            )
          }
          {/* The leaf is shown so the trail matches the BreadcrumbList exactly. */}
          <span aria-hidden="true">/</span>
          <span aria-current="page" class="text-chalk">{tool.name}</span>
        </nav>
        {/* The category stays in the h1 — quieter, but there for anyone searching it. */}
        <h1 class="mt-1 text-[clamp(1.9rem,4.5vw,3rem)] text-chalk">
          {name.prefix && <span class="text-faint">{name.prefix}</span>}{name.prefix && ' '}{name.rest}
        </h1>
      </div>
      <p class="ud-legend max-w-md leading-relaxed">
        {tool.tagline} · {ui.tool.taglineSuffix}
      </p>
    </div>

    <div class="mt-4">
      <slot />
    </div>

    {/* Indexable prose. Also the part a security reviewer reads. */}
    <div class="mt-16 grid gap-x-12 gap-y-10 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <div class="max-w-2xl">
        <h2 class="border-t-2 border-cherry pt-4 text-[1.75rem] text-chalk">
          {fill(ui.tool.howItWorks, { name: tool.name })}
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-temper">{tool.overview ?? tool.description}</p>

        {/* Indexable copy, so it translates like everything else and lives in
            the dictionary rather than in a per-page slot. */}
        {
          about && (
            <div class="mt-4 space-y-4 text-sm leading-relaxed text-temper">
              {about.map((paragraph) => (
                <p>
                  <Rich text={paragraph} locale={locale} />
                </p>
              ))}
            </div>
          )
        }
      </div>

      {
        related.length > 0 && (
          <aside>
            <h2 class="ud-legend border-t border-scribe-strong pt-4">{ui.tool.otherTools}</h2>
            <ul class="mt-2">
              {related.map((item) => (
                <li>
                  <a
                    href={href(item.href, locale)}
                    class="group flex items-baseline justify-between gap-3 border-b border-scribe py-3 transition-colors hover:bg-anvil"
                  >
                    <span class="ud-struck text-lg text-chalk">
                      <span class="text-faint">{splitName(item).prefix}</span>{' '}
                      {splitName(item).rest}
                    </span>
                    {/* The arrow says "link". */}
                    <Icon
                      name="arrow-right"
                      size={13}
                      class="shrink-0 text-faint transition-all group-hover:translate-x-0.5 group-hover:text-cherry"
                    />
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>

    {
      faqs.length > 0 && (
        <section class="mt-16">
          <h2 class="border-t-2 border-cherry pt-4 text-[1.75rem] text-chalk">
            {ui.tool.commonQuestions}
          </h2>
          <div class="mt-6 grid gap-x-12 md:grid-cols-2">
            {faqs.map((faq) => (
              <div class="border-t border-scribe py-5">
                <h3 class="ud-struck text-lg text-chalk">{faq.q}</h3>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-temper">{faq.a}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
