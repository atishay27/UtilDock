---
import BaseLayout from './BaseLayout.astro';
import { SITE, absoluteUrl } from '../lib/site';
import { getCategory, getTool, relatedTools, splitName } from '../lib/tools';
import Icon from '../components/Icon.astro';

interface Props {
  toolId: string;
}

const { toolId } = Astro.props;
const tool = getTool(toolId);
const category = getCategory(tool.category);
const related = relatedTools(tool.id);
const url = absoluteUrl(tool.href);
const categoryUrl = category.href ? absoluteUrl(category.href) : undefined;
const name = splitName(tool);
const faqs = tool.faqs ?? [];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: `${tool.name} — ${SITE.name}`,
      url,
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Online tool',
      operatingSystem: 'Any',
      description: tool.description,
      browserRequirements: 'Requires JavaScript',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      isAccessibleForFree: true,
      featureList: tool.keywords,
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: absoluteUrl('/') },
        ...(categoryUrl
          ? [{ '@type': 'ListItem', position: 2, name: category.name, item: categoryUrl }]
          : []),
        {
          '@type': 'ListItem',
          position: categoryUrl ? 3 : 2,
          name: tool.name,
          item: url,
        },
      ],
    },
    ...(faqs.length > 0
      ? [
          {
            '@type': 'FAQPage',
            mainEntity: faqs.map((faq) => ({
              '@type': 'Question',
              name: faq.q,
              acceptedAnswer: { '@type': 'Answer', text: faq.a },
            })),
          },
        ]
      : []),
  ],
};
---

<BaseLayout
  title={tool.title}
  description={tool.description}
  keywords={tool.keywords}
  structuredData={structuredData}
>
  <div class="mx-auto max-w-[1600px] px-4 pt-5 pb-10 sm:px-6">
    {/* The workpiece plate: name, and what this station does.

        It opened with a large tabular numeral, which was the tool's position in
        the registry array and nothing else — no rank, no sequence, no step. On
        a page dedicated to one tool it answered a question nobody had, and it
        set the plate's alignment against a figure that carried no meaning. */}
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3 border-b-2 border-scribe-strong pb-4">
      <div>
        <nav aria-label="Breadcrumb" class="ud-legend flex items-center gap-2">
          <a href="/" class="transition-colors hover:text-chalk">Home</a>
          <span aria-hidden="true">/</span>
          {
            category.href ? (
              <a href={category.href} class="transition-colors hover:text-chalk">
                {category.name}
              </a>
            ) : (
              <span>{category.name}</span>
            )
          }
        </nav>
        {/* The category stays in the h1 — quieter, but there for anyone searching it. */}
        <h1 class="mt-1 text-[clamp(1.9rem,4.5vw,3rem)] text-chalk">
          {name.prefix && <span class="text-faint">{name.prefix}</span>}{name.prefix && ' '}{name.rest}
        </h1>
      </div>
      <p class="ud-legend max-w-md leading-relaxed">
        {tool.tagline} · runs in this tab, never sent anywhere
      </p>
    </div>

    <div class="mt-4">
      <slot />
    </div>

    {/* Indexable prose. Also the part a security reviewer reads. */}
    <div class="mt-16 grid gap-x-12 gap-y-10 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <div class="max-w-2xl">
        <h2 class="border-t-2 border-cherry pt-4 text-[1.75rem] text-chalk">
          How the {tool.name} works
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-temper">{tool.overview ?? tool.description}</p>
        <slot name="about" />
      </div>

      {
        related.length > 0 && (
          <aside>
            <h2 class="ud-legend border-t border-scribe-strong pt-4">Other tools</h2>
            <ul class="mt-2">
              {related.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="group flex items-baseline justify-between gap-3 border-b border-scribe py-3 transition-colors hover:bg-anvil"
                  >
                    <span class="ud-struck text-lg text-chalk">
                      <span class="text-faint">{splitName(item).prefix}</span>{' '}
                      {splitName(item).rest}
                    </span>
                    {/* The arrow says "link"; the numeral it replaced said only
                        where this tool happened to sit in an array. */}
                    <Icon
                      name="arrow-right"
                      size={13}
                      class="shrink-0 text-faint transition-all group-hover:translate-x-0.5 group-hover:text-cherry"
                    />
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>

    {
      faqs.length > 0 && (
        <section class="mt-16">
          <h2 class="border-t-2 border-cherry pt-4 text-[1.75rem] text-chalk">
            Common questions
          </h2>
          <div class="mt-6 grid gap-x-12 md:grid-cols-2">
            {faqs.map((faq) => (
              <div class="border-t border-scribe py-5">
                <h3 class="ud-struck text-lg text-chalk">{faq.q}</h3>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-temper">{faq.a}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
