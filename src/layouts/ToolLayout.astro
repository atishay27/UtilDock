---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../lib/site';
import { CATEGORIES, getTool, relatedTools } from '../lib/tools';

interface Props {
  toolId: string;
}

const { toolId } = Astro.props;
const tool = getTool(toolId);
const category = CATEGORIES.find((c) => c.id === tool.category)!;
const related = relatedTools(tool.id);
const url = new URL(tool.href, SITE.url).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: `${tool.name} — ${SITE.name}`,
      url,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      description: tool.description,
      browserRequirements: 'Requires JavaScript',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      isAccessibleForFree: true,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: category.name, item: url },
        { '@type': 'ListItem', position: 3, name: tool.name, item: url },
      ],
    },
  ],
};
---

<BaseLayout
  title={tool.title}
  description={tool.description}
  keywords={tool.keywords}
  structuredData={structuredData}
>
  <div class="mx-auto max-w-[1400px] px-4 pt-6 pb-10 sm:px-6">
    <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-faint">
      <a href="/" class="transition-colors hover:text-content">Home</a>
      <Icon name="chevron-right" size={13} />
      <span class="text-muted">{category.name}</span>
      <Icon name="chevron-right" size={13} />
      <span class="text-content">{tool.name}</span>
    </nav>

    <div class="mt-3">
      <h1 class="flex items-center gap-2.5 text-2xl font-semibold tracking-tight text-content">
        <Icon name={tool.icon} size={22} class="text-accent" />
        {tool.name}
      </h1>
      <p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-muted">
        {tool.tagline}. <span class="text-faint">Runs entirely in this tab — nothing is uploaded.</span>
      </p>
    </div>

    <div class="mt-5">
      <slot />
    </div>

    <!-- Prose block: gives the page something for search engines to index
         beyond the app shell, and answers the obvious questions. -->
    <div class="mt-14 grid gap-10 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <div class="max-w-2xl">
        <h2 class="text-lg font-semibold text-content">About this tool</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">{tool.description}</p>
        <slot name="about" />
      </div>

      {
        related.length > 0 && (
          <aside>
            <h2 class="text-xs font-semibold tracking-wider text-faint uppercase">Related tools</h2>
            <ul class="mt-3 space-y-2">
              {related.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="flex items-center gap-2.5 rounded-lg border border-line bg-surface px-3 py-2.5 text-sm text-content transition-colors hover:border-line-strong hover:bg-surface-2"
                  >
                    <Icon name={item.icon} size={16} class="shrink-0 text-accent" />
                    <span>{item.name}</span>
                    <Icon name="arrow-right" size={15} class="ml-auto shrink-0 text-faint" />
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>
