# Measurement IDs. Set these in the Cloudflare Pages project
# (Settings → Environment variables) for the Production environment only.
#
# Leave them unset locally and in previews: with no ID the container, the
# consent banner and the Google hosts in the CSP are all inert, so development
# traffic is never counted and the local build stays entirely same-origin.

# Google Tag Manager container, e.g. GTM-XXXXXXX. When this is set, GTM owns the
# GA4 configuration tag and PUBLIC_GA_ID below is ignored — firing both against
# the same property would double-count every page view.
PUBLIC_GTM_ID=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Only used when
# PUBLIC_GTM_ID is empty, i.e. when loading GA4 directly without a container.
PUBLIC_GA_ID=
